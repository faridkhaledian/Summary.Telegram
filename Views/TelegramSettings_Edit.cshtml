@model Summary.Telegram.Settings.TelegramSettings

<div class="row">
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Token">
      <label asp-for="Token">
        توکن بات
      </label>
      <input type="text" asp-for="Token" class="form-control" />
      <span class="hint">
        توکن مربوط به بات تلگرام را در این فیلد وارد کنید.
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Mobile">
      <label asp-for="Mobile">
        شماره موبایل
      </label>
      <input type="text" asp-for="Mobile" class="form-control" />
      <span class="hint">
        شماره موبایلی که برای اتصال و احراز هویت حساب تلگرام استفاده می‌شود.
        مثال: 989121234567+
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Api_Id">
      <label asp-for="Api_Id">
        API ID
      </label>
      <input type="text" asp-for="Api_Id" class="form-control" />
      <span class="hint">
        شناسه API برنامه تلگرام که از my.telegram.org دریافت می‌شود.
      </span>
    </div>
    <div class="form-group" asp-validation-class-for="Api_Hash">
      <label asp-for="Api_Hash">
        API Hash
      </label>
      <input type="text" asp-for="Api_Hash" class="form-control" />
      <span class="hint">
        کلید API مربوط به برنامه تلگرام که همراه API ID دریافت می‌شود.
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Session_Path">
      <label asp-for="Session_Path">
        مسیر Session
      </label>
      <input type="text" asp-for="Session_Path" class="form-control" />
      <span class="hint">
        مسیر ذخیره فایل Session تلگرام. مثال:
        telegram.session
      </span>
    </div>
  </div>
</div>